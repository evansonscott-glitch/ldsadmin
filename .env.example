# Sam LDS Assistant - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# === Gmail IMAP Access ===
GMAIL_EMAIL=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_SMTP_SERVER=smtp.gmail.com

# === Google Service Account (for Calendar/Drive) ===
# Path to your downloaded service account JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/google-service-account.json

# === Google Calendar ===
# Optional: specify calendar ID (default: primary)
# Get from Calendar Settings → Integrate calendar → Calendar ID
GOOGLE_CALENDAR_ID=primary
TIMEZONE=America/Denver

# === LDS Church Account (for LCR access) ===
LDS_USERNAME=your-lds-username
LDS_PASSWORD=your-lds-password
