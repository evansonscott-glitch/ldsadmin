# Sam LDS Assistant - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Gmail IMAP Access (for email features)
GMAIL_EMAIL=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Google Service Account (for Calendar/Drive)
# Path to your downloaded service account JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/google-service-account.json

# LDS Church Account (for LCR access - optional)
LDS_USERNAME=your-lds-username
LDS_PASSWORD=your-lds-password
